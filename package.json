{
  "name": "react-offline-first",
  "version": "0.1.0",
  "description": "Offline-first React hooks, sync queue, and network status — zero runtime deps beyond React",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/bhuvaneshwararaja/react-offline-first.git"
  },
  "bugs": {
    "url": "https://github.com/bhuvaneshwararaja/react-offline-first/issues"
  },
  "homepage": "https://github.com/bhuvaneshwararaja/react-offline-first#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.mjs",
      "types": "./dist/hooks/index.d.ts"
    },
    "./adapters": {
      "import": "./dist/adapters/index.mjs",
      "types": "./dist/adapters/index.d.ts"
    },
    "./sw": {
      "import": "./dist/sw.js",
      "types": "./dist/sw.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rollup -c rollup.config.mjs && node scripts/write-sw-worker.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "size": "size-limit",
    "build:examples": "pnpm --filter \"./examples/*\" run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish",
    "prepublishOnly": "pnpm run build"
  },
  "size-limit": [
    {
      "name": "Core ESM (gzip)",
      "path": "dist/index.mjs",
      "limit": "8 KB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@eslint/js": "^9.16.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@size-limit/file": "^11.1.4",
    "@storybook/addon-docs": "^8.4.7",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.13.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^4.28.1",
    "size-limit": "^11.1.4",
    "storybook": "^8.4.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
